{
  "name": "prokuroweb",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Next.js frontend for Prokuro",
  "scripts": {
    "dev": "next dev --port 3010",
    "clean": "rm -rf .next out tsconfig.tsbuildinfo .pages-stash",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "pages:branch": "node scripts/build-pages.mjs && node scripts/sync-pages-to-docs.mjs",
    "start": "next start --port 3010",
    "lint": "eslint app components lib hooks --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:tail": "wrangler tail --config worker/wrangler.toml"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@tailwindcss/typography": "^0.5.15",
    "aws-amplify": "^6.18.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lenis": "^1.3.26",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.114.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prokuro-ai/prokuroWeb.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/prokuro-ai/prokuroWeb/issues"
  },
  "homepage": "https://github.com/prokuro-ai/prokuroWeb#readme"
}
