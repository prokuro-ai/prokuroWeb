# Copy this file to .env.local for local development (Next.js does NOT read .env.local.example).
# Restart `npm run dev` after changing env vars.

# Calendly Scheduling API (server-only — never put these in NEXT_PUBLIC_*)
# Do NOT use Developer Portal OAuth Client ID / Client Secret here.
# Use a Personal Access Token from your Calendly account:
#   https://calendly.com/integrations/api_webhooks
#   → "API and webhooks" → Personal Access Tokens → Generate new token
# Requires a paid Calendly plan for booking (POST /invitees).
# Find the event type URI with:
#   curl -H "Authorization: Bearer $TOKEN" "https://api.calendly.com/event_types?user=<your user uri>"
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/YOUR_EVENT_TYPE_UUID
# Optional override if auto-detection picks the wrong location:
# CALENDLY_LOCATION_KIND=google_conference

# GitHub Pages / static export only — public scheduling page (no secrets).
# Example: https://calendly.com/your-handle/prokuro-demo
# NEXT_PUBLIC_CALENDLY_URL=
# Project Pages path, e.g. /prokuroWeb — leave unset for a custom domain at the root.
# NEXT_PUBLIC_BASE_PATH=

GATEWAY_URL=http://localhost:3000
# Set in production so parse/analyze bypass Amplify's 30s API proxy timeout
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# Cognito (required for signed-in BOM APIs)
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_COGNITO_DOMAIN=   # required for Google sign-in

# Gateway also needs matching Cognito env vars for BOM auth:
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=us-west-2

# Local BOM persistence (gateway uses filesystem when BOM_BUCKET_NAME is unset)
# BOM_STORAGE_PATH=.data/boms
